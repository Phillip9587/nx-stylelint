{
  "name": "e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "e2e/tests",
  "implicitDependencies": ["nx-stylelint"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        {
          "runtime": "node -v"
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "jest --config e2e/jest.config.ts --runInBand --passWithNoTests",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "ci": {
          "command": "jest --config e2e/jest.config.ts --runInBand --passWithNoTests --ci --coverage"
        }
      },
      "dependsOn": ["^build"]
    }
  }
}
